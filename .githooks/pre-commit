#!/bin/sh
# Git pre-commit hook: 在 git 提交前使用 ./mvnw 自动格式化代码

# 获取暂存区中变动的 Java 文件列表
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.java$')

# 若本次提交不包含 Java 文件，则直接放行
if [ -z "$STAGED_JAVA_FILES" ]; then
    exit 0
fi

echo "--------------------------------------------------------"
echo " [Git Hook] 检测到 Java 文件变更，使用 ./mvnw 格式化代码..."
echo "--------------------------------------------------------"

# 确定 Maven Wrapper 命令
if [ -f "./mvnw" ]; then
    MAVEN_CMD="./mvnw"
elif [ -f "./mvnw.cmd" ]; then
    MAVEN_CMD="./mvnw.cmd"
else
    MAVEN_CMD="mvn"
fi

# 执行 代码格式化 (formatter:format) 与 Import 排序 (impsort:sort)
$MAVEN_CMD formatter:format impsort:sort -q

STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo " Error: ./mvnw 代码格式化失败，取消提交。"
    exit $STATUS
fi

# 将格式化后的 Java 文件重新加入暂存区
for FILE in $STAGED_JAVA_FILES; do
    if [ -f "$FILE" ]; then
        git add "$FILE"
    fi
done

echo " [Git Hook] 代码格式化完成并已重新自动加入暂存区。"
exit 0
